    "formik": "^2.4.9",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-pwa": "^5.6.0",
    "prisma": "^7.4.0",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "query-string": "^9.3.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
