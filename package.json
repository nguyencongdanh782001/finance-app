{
  "name": "finance-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "db:backup:prod": "bash scripts/backup-prod-db.sh",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:clone-prod-to-dev": "bash scripts/clone-prod-to-dev-db.sh",
    "dev": "next dev --webpack",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "start": "next start",
    "test": "node --no-warnings --test --experimental-strip-types src/lib/sold-products/sold-products.test.ts src/lib/products/product-draft-validation.test.ts src/lib/products/product-status.test.ts src/lib/products/product-preview.test.ts src/lib/products/variant-groups.test.ts src/lib/products/variant-removal.test.ts src/lib/products/import/parser.test.ts src/lib/orders/shop-order-products.test.ts src/lib/orders/order-status.test.ts src/lib/rich-text.test.ts src/lib/geoapify.test.ts src/lib/shipping.test.ts src/lib/chat-assistant/engine.test.ts src/lib/chat-assistant/request.test.ts src/lib/recommendations.test.ts src/lib/reviews-policy.test.ts",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "dependencies": {
