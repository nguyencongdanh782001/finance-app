  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("push_subscription")
}

model NotificationOutbox {
  id             String                   @id @default(cuid())
  eventKey       String                   @unique
  eventType      AdminNotificationType
  aggregateId    Int
  notificationId String
  payload        Json
  status         NotificationOutboxStatus @default(PENDING)
  attempts       Int                      @default(0)
  nextRetryAt    DateTime?
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@map("notification_outbox")
}

model SearchHistory {
  id Int @id @default(autoincrement())

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  keyword     String
  filters     Json?
  resultCount Int?
  ipAddress   String?
  userAgent   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([keyword])
  @@index([createdAt])
  @@map("search_history")
}

model RecentlyViewedProduct {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([viewedAt])
  @@map("recently_viewed_product")
}

model ProductViewEvent {
  id Int @id @default(autoincrement())

  visitorId String?
  userId    Int?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // One event per identity/product in each fixed 30-minute UTC window.
  dedupeKey String @unique
  viewedAt  DateTime @default(now())

  @@index([visitorId, productId, viewedAt])
  @@index([userId, viewedAt])
  @@index([categoryId, viewedAt])
  @@index([viewedAt])
  @@map("product_view_event")
}

model HomepageBanner {
  id Int @id @default(autoincrement())

  internalName        String                  @default("Banner trang chủ")
  title               String
  subtitle            String?
  eyebrow             String?
  description         String?
  imageUrl            String
  desktopImage        String?
  mobileImage         String?
  imagePublicId       String?
  mobileImagePublicId String?
  imageAlt            String                  @default("")
  linkUrl             String?
  primaryCtaLabel     String?
  primaryCtaUrl       String?
  secondaryCtaLabel   String?
  secondaryCtaUrl     String?
  textAlignment       BannerTextAlignment     @default(LEFT)
  textTheme           BannerTextTheme         @default(LIGHT)
  overlayOpacity      Int                     @default(20)
  placement           HomepageBannerPlacement @default(HERO)
  position            Int                     @default(0)
  isActive            Boolean                 @default(true)
  startsAt            DateTime?
  endsAt              DateTime?
  createdById         Int?
  updatedById         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement])
  @@index([isActive])
  @@index([position])
  @@index([placement, isActive, position])
  @@index([startsAt, endsAt])
  @@map("homepage_banner")
}

model StorePolicy {
  id             Int          @id @default(autoincrement())
  type           PolicyType
  title          String
  slug           String       @unique
  summary        String?
  summaryJson    Json?
  summaryHtml    String?
  summaryText    String?
  content        Json
  contentJson    Json?
  contentHtml    String?
  status         PolicyStatus @default(DRAFT)
  showInFooter   Boolean      @default(true)
  footerOrder    Int          @default(0)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdById    Int?
  updatedById    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, showInFooter, footerOrder])
  @@index([type])
  @@map("store_policy")
}

model HomepageFeaturedProduct {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  title    String?
  position Int       @default(0)
  isActive Boolean   @default(true)
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId])
  @@index([isActive])
  @@index([position])
  @@map("homepage_featured_product")
}

model HomepageSection {
  id Int @id @default(autoincrement())

  title    String
  subtitle String?
  type     HomepageSectionType
  position Int                 @default(0)
  isActive Boolean             @default(true)
  config   Json?

  products HomepageSectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([position])
  @@map("homepage_section")
}

model HomepageSectionProduct {
  id Int @id @default(autoincrement())

  sectionId Int
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  position Int @default(0)

  @@unique([sectionId, productId])
  @@index([sectionId])
  @@index([productId])
  @@index([position])
  @@map("homepage_section_product")
}
