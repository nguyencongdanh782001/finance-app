// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AuthProvider {
  WEB
  GOOGLE
}

enum OtpPurpose {
  LOGIN
  REGISTER
  VERIFY_PHONE
  RESET_PASSWORD
}

enum LegacyProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum ProductStatus {
  PUBLIC
  PRIVATE
  DISCONTINUED
}

enum ProductGender {
  WOMEN
  MEN
  UNISEX
  KIDS
}

enum UserGender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum LegacyProductVisibility {
  PUBLIC
  HIDDEN
  PRIVATE
}

enum ProductImportStatus {
  UPLOADED
  VALIDATING
  READY
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
}

enum ProductImportMode {
  CREATE_ONLY
}

enum ProductDraftMode {
  CREATE
  EDIT
}

enum ProductDraftStatus {
  ACTIVE
  APPLIED
  DISCARDED
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
}

enum OrderSource {
  OFFLINE
  ONLINE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOIDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_TO_SHIP
  SHIPPING
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PROCESSING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  COD
  CARD
  BANK_TRANSFER
  ZALOPAY
  PAYPAL
  STRIPE
}

enum TryOnCategory {
  UPPER_BODY
  LOWER_BODY
  DRESSES
  SHOES
  ACCESSORIES
  NOT_SUPPORTED
}

enum ShippingStatus {
  PENDING
  READY_TO_SHIP
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ShippingDistanceRoundingMode {
  EXACT
  UP_TO_0_5_KM
  UP_TO_1_KM
}

enum CouponSource {
  MANUAL
  BIRTHDAY
}

enum NotificationType {
  ORDER
  PAYMENT
  SHIPPING
  PROMOTION
  SYSTEM
}

enum AdminNotificationType {
  NEW_ONLINE_ORDER
  ONLINE_PAYMENT_SUCCESS
  ONLINE_PAYMENT_FAILED
  ORDER_CANCELLED
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  PARTIALLY_SENT
  FAILED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InventoryTransactionType {
  IMPORT
  EXPORT
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RELEASE
}

enum HomepageBannerPlacement {
  HERO
  TOP
  MIDDLE
  BOTTOM
  ANNOUNCEMENT_BAR
  HOME_HERO
  HOME_CAMPAIGN
  HOME_CATEGORY
  PRODUCT_LISTING
}

enum BannerTextAlignment {
  LEFT
  CENTER
  RIGHT
}

enum BannerTextTheme {
  LIGHT
  DARK
}

enum PolicyStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum PolicyType {
  PURCHASE_GUIDE
  SHIPPING
  RETURN_REFUND
  PRIVACY
  TERMS
  PAYMENT
  OTHER
}

enum HomepageSectionType {
  BANNER
  FEATURED_PRODUCTS
  CATEGORY_PRODUCTS
  CUSTOM
}

enum PaymentLogType {
  CREATED
  REDIRECTED
  WEBHOOK_RECEIVED
  VERIFIED
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  MANUAL_UPDATE
}

enum MembershipBenefitType {
  PERCENTAGE_ORDER_DISCOUNT
  FIXED_ORDER_DISCOUNT
  FREE_SHIPPING
  BIRTHDAY_VOUCHER
  EARLY_ACCESS
  EXCLUSIVE_PRODUCTS
  BONUS_POINTS
  CAMPAIGN_ACCESS
  FREE_GIFT
  CUSTOM_TEXT
}

enum MembershipResetStatus {
  RUNNING
  COMPLETED
  FAILED
}

model DailyFinance {
  id Int @id @default(autoincrement())

  date DateTime @unique

  /// Relation
  monthlyFinanceId Int
  monthlyFinance   MonthlyFinance @relation(fields: [monthlyFinanceId], references: [id], onDelete: Cascade)

  /// CAPITALIZATION
  capitalCash Decimal @default(0)
  capitalBank Decimal @default(0)

  /// REVENUE
  revenueCash Decimal @default(0)
  revenueBank Decimal @default(0)

  /// PROFIT (calculate & save)
  profitCash  Decimal @default(0)
  profitBank  Decimal @default(0)
  totalProfit Decimal @default(0)

  /// NOTE
  note String?

  /// SOLD PRODUCTS
  soldProducts           DailySoldProduct[]
  dailySoldContributions DailySoldProductContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_finance")
}

model MonthlyExpense {
  id Int @id @default(autoincrement())

  monthlyFinanceId Int
  monthlyFinance   MonthlyFinance @relation(fields: [monthlyFinanceId], references: [id], onDelete: Cascade)

  name   String
  amount Decimal

  createdAt DateTime @default(now())

  @@map("monthly_expense")
}

model MonthlyFinance {
  id Int @id @default(autoincrement())

  year  Int
  month Int

  /// Total profit for days of the month
  totalDailyProfit Decimal @default(0)

  /// Total spending for the month
  totalExpense Decimal @default(0)

  /// Monthly profit
  /// totalDailyProfit - totalExpense
  profit Decimal @default(0)

  /// Relations
  days     DailyFinance[]
  expenses MonthlyExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month])
  @@map("monthly_finance")
}

model Category {
  id Int @id @default(autoincrement())

  name       String
  color      String
  icon       String
  position   Int     @default(0)
  isActive   Boolean @default(true)
  tryOnCategory TryOnCategory @default(NOT_SUPPORTED)
  seoImage   String?
  metaRobots String?

  /// E-commerce fields
  slug        String?    @unique
  description String?
  parentId    Int?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")

  /// Relation
  products        Product[]
  productViewEvents ProductViewEvent[]
  couponProducts  CouponCategory[]
  excludedCoupons ExcludedCouponCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([position])
  @@index([isActive])
  @@index([tryOnCategory])
  @@map("category")
}

model Brand {
  id Int @id @default(autoincrement())

  name        String  @unique
  slug        String  @unique
  logo        String?
  description String?
  website     String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@map("brand")
}

model Product {
  id Int @id @default(autoincrement())

  title String

  /// file (image url hoặc path)
  imageUrl      String
  imagePublicId String

  /// Category relation
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  brandId       Int?
  brandRelation Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  /// Price
  importPrice Decimal
  sellPrice   Decimal

  /// Stock
  quantity Int @default(0)

  organicFavoriteCount    Int @default(0)
  favoriteCountAdjustment Int @default(0)

  /// E-commerce fields
  slug               String?                 @unique
  description        String?
  descriptionContent Json?
  descriptionHtml    String?
  productStatus      LegacyProductStatus?    @default(DRAFT)
  visibility         LegacyProductVisibility @default(PUBLIC)
  status             ProductStatus           @default(PRIVATE)
  brand              String?
  material           String?
  careInstructions   String?
  gender             ProductGender?
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String?
  isFeatured         Boolean                 @default(false)
  viewCount          Int                     @default(0)
  soldCount          Int                     @default(0)
  publishedAt        DateTime?
  isPublished        Boolean                 @default(false)
  tags               Json?
  videoUrl           String?
  weight             Decimal?
  length             Decimal?
  width              Decimal?
  height             Decimal?

  /// Relations
  dailySales               DailySoldProduct[]
  dailySoldContributions   DailySoldProductContribution[]
  images                   ProductImage[]
  variantGroups            VariantGroup[]
  variants                 ProductVariant[]
  inventoryTransactions    InventoryTransaction[]
  cartItems                CartItem[]
  wishlistItems            WishlistItem[]
  orderItems               OrderItem[]
  reviews                  Review[]
  couponProducts           CouponProduct[]
  excludedCouponProducts   ExcludedCouponProduct[]
  homepageFeaturedProducts HomepageFeaturedProduct[]
  homepageSectionProducts  HomepageSectionProduct[]
  recentlyViewedBy         RecentlyViewedProduct[]
  productViewEvents        ProductViewEvent[]
  drafts                   ProductDraft[]
  favoriteAdjustmentLogs   ProductFavoriteAdjustmentLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([categoryId])
  @@index([brandId])
  @@index([brand])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([status])
  @@index([status, categoryId])
  @@index([status, createdAt])
  @@map("product")
}

model DailySoldProduct {
  id Int @id @default(autoincrement())

  dailyFinanceId Int
  dailyFinance   DailyFinance @relation(fields: [dailyFinanceId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  importPrice   Decimal
  sales         Json
  contributions DailySoldProductContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dailyFinanceId, productId])
  @@index([dailyFinanceId])
  @@index([productId])
  @@map("daily_sold_product")
}

model DailySoldProductContribution {
  id Int @id @default(autoincrement())

  dailyFinanceId Int
  dailyFinance   DailyFinance @relation(fields: [dailyFinanceId], references: [id], onDelete: Cascade)

  dailySoldProductId Int?
  dailySoldProduct   DailySoldProduct? @relation(fields: [dailySoldProductId], references: [id], onDelete: SetNull)

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItemId Int       @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  quantity  Int
  sellPrice Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dailyFinanceId])
  @@index([dailySoldProductId])
  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("daily_sold_product_contribution")
}

model User {
  id Int @id @default(autoincrement())

  phone        String?      @unique
  email        String?      @unique
  googleId     String?      @unique
  passwordHash String?
  authProvider AuthProvider @default(WEB)
  role         UserRole     @default(CUSTOMER)
  status       UserStatus   @default(ACTIVE)

  firstName    String?
  lastName     String?
  displayName  String?
  avatarUrl    String?
  birthday     DateTime?
  gender       UserGender?
  totalOrders  Int         @default(0)
  totalSpent   Decimal     @default(0)
  rewardPoints Int         @default(0)

  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  membershipId Int?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  sessions                    UserSession[]
  otps                        Otp[]
  passwordResetTokens         PasswordResetToken[]
  addresses                   UserAddress[]
  carts                       Cart[]
  wishlists                   Wishlist[]
  wishlistItems               WishlistItem[]
  orders                      Order[]
  createdOrders               Order[]                        @relation("OrderCreatedBy")
  updatedOrders               Order[]                        @relation("OrderUpdatedBy")
  issuedInvoices              OrderInvoice[]                 @relation("InvoiceIssuedBy")
  voidedInvoices              OrderInvoice[]                 @relation("InvoiceVoidedBy")
  orderStatusChanges          OrderStatusHistory[]
  reviews                     Review[]
  notifications               Notification[]
  searchHistories             SearchHistory[]
  recentlyViewedProducts      RecentlyViewedProduct[]
  productDrafts               ProductDraft[]
  productImportJobs           ProductImportJob[]
  birthdayCoupons             Coupon[]                       @relation("BirthdayCoupons")
  membershipHistories         MembershipHistory[]
  benefitRedemptions          MembershipBenefitRedemption[]
  favoriteAdjustmentLogs      ProductFavoriteAdjustmentLog[] @relation("ProductFavoriteAdjustmentAdmin")
  adminNotificationRecipients AdminNotificationRecipient[]
  pushSubscriptions           PushSubscription[]
  productViewEvents           ProductViewEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
  @@index([googleId])
  @@index([authProvider])
  @@index([role])
  @@index([status])
  @@index([membershipId])
  @@index([totalOrders])
  @@index([rewardPoints])
  @@map("user")
}

model ProductDraft {
  id Int @id @default(autoincrement())

  mode   ProductDraftMode
  status ProductDraftStatus @default(ACTIVE)

  originalProductId Int?
  originalProduct   Product? @relation(fields: [originalProductId], references: [id], onDelete: Cascade)

  createdById Int
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  currentStep String?
  data        Json
  version     Int     @default(1)

  appliedAt   DateTime?
  discardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdById, status])
  @@index([originalProductId, status])
  @@map("product_draft")
}

model ProductImportJob {
  id                      String              @id @default(cuid())
  status                  ProductImportStatus @default(UPLOADED)
  fileName                String
  mode                    ProductImportMode   @default(CREATE_ONLY)
  createMissingCategories Boolean             @default(false)
  forcePrivate            Boolean             @default(false)
  totalProducts           Int                 @default(0)
  totalVariants           Int                 @default(0)
  totalImages             Int                 @default(0)
  processed               Int                 @default(0)
  succeeded               Int                 @default(0)
  failed                  Int                 @default(0)
  skipped                 Int                 @default(0)
  sourceData              Json?
  validationErrors        Json?
  resultData              Json?
  processingToken         String?
  processingStartedAt     DateTime?
  createdById             Int
  createdBy               User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  completedAt             DateTime?

  @@index([createdById, createdAt])
  @@index([status, updatedAt])
  @@map("product_import_job")
}

model PasswordResetToken {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model UserSession {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash             String    @unique
  expiresAt             DateTime
  revokedAt             DateTime?
  device                String?
  userAgent             String?
  ipAddress             String?
  refreshTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshTokenExpiresAt])
  @@map("user_session")
}

model Membership {
  id Int @id @default(autoincrement())

  name        String  @unique
  code        String  @unique
  description String?
  terms       String?
  level       Int     @default(0)
  color       String?
  icon        String?
  priority    Int     @default(0)
  benefits    Json?
  isActive    Boolean @default(true)

  minSpendAmount            Decimal  @default(0)
  discountRate              Decimal  @default(0)
  birthdayMaxDiscountAmount Decimal?

  users        User[]
  coupons      CouponMembership[]
  histories    MembershipHistory[]
  benefitTiers MembershipBenefitTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([level])
  @@index([priority])
  @@index([isActive])
  @@map("membership")
}

model MembershipHistory {
  id Int @id @default(autoincrement())

  userId       Int
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipId Int?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  membershipNameSnapshot String
  minSpendAmountSnapshot Decimal  @default(0)
  discountRateSnapshot   Decimal  @default(0)
  cycleYear              Int
  spending               Decimal  @default(0)
  rankStartDate          DateTime
  rankEndDate            DateTime
  reason                 String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cycleYear])
  @@index([cycleYear])
  @@index([membershipId, cycleYear])
  @@map("membership_history")
}

model MembershipBenefit {
  id Int @id @default(autoincrement())

  name                   String
  code                   String                @unique
  description            String?
  type                   MembershipBenefitType
  icon                   String?
  isActive               Boolean               @default(true)
  position               Int                   @default(0)
  startsAt               DateTime?
  endsAt                 DateTime?
  usageLimit             Int?
  usedCount              Int                   @default(0)
  usageLimitPerUser      Int?
  automatic              Boolean               @default(true)
  requiresRedemption     Boolean               @default(false)
  minOrderValue          Decimal?
  maxDiscountAmount      Decimal?
  salesChannels          Json?
  canCombineWithCoupons  Boolean               @default(false)
  canCombineWithBenefits Boolean               @default(false)
  priority               Int                   @default(0)
  internalNotes          String?

  tiers       MembershipBenefitTier[]
  redemptions MembershipBenefitRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([type])
  @@index([position])
  @@map("membership_benefit")
}

model MembershipBenefitTier {
  id           Int               @id @default(autoincrement())
  benefitId    Int
  benefit      MembershipBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  membershipId Int
  membership   Membership        @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  value        Decimal?
  config       Json?

  @@unique([benefitId, membershipId])
  @@index([membershipId])
  @@map("membership_benefit_tier")
}

model MembershipBenefitRedemption {
  id            Int                   @id @default(autoincrement())
  benefitId     Int
  benefit       MembershipBenefit     @relation(fields: [benefitId], references: [id], onDelete: Restrict)
  userId        Int
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderId       Int?
  order         Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cycleYear     Int
  valueSnapshot Decimal?
  nameSnapshot  String
  typeSnapshot  MembershipBenefitType
  amount        Decimal               @default(0)
  redeemedAt    DateTime              @default(now())

  @@unique([benefitId, userId, orderId])
  @@index([userId, cycleYear])
  @@index([benefitId, redeemedAt])
  @@map("membership_benefit_redemption")
}

model MembershipResetRun {
  id             Int                   @id @default(autoincrement())
  cycleYear      Int                   @unique
  status         MembershipResetStatus @default(RUNNING)
  reason         String?
  processedCount Int                   @default(0)
  startedAt      DateTime              @default(now())
  completedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status])
  @@map("membership_reset_run")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  actorId       Int?
  action        String
  entityType    String
  entityId      Int?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_log")
}

model Otp {
  id Int @id @default(autoincrement())

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone    String?
  email    String?
  codeHash String
  purpose  OtpPurpose

  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  ipAddress    String?
  device       String?
  userAgent    String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([phone, purpose])
  @@index([email, purpose])
  @@index([expiresAt])
  @@index([ipAddress])
  @@map("otp")
}

model UserAddress {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       AddressType @default(BOTH)
  fullName   String
  phone      String
  line1      String
  line2      String?
  ward       String?
  district   String?
  city       String
  province   String?
  postalCode String?
  country    String      @default("VN")
  latitude   Decimal?
  longitude  Decimal?

  isDefaultShipping Boolean @default(false)
  isDefaultBilling  Boolean @default(false)

  shippingOrders Order[] @relation("UserOrderShippingAddress")
  billingOrders  Order[] @relation("UserOrderBillingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([latitude, longitude])
  @@map("user_address")
}

model ProductImage {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  url       String
  publicId  String?
  altText   String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@map("product_image")
}

model VariantGroup {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name     String
  slug     String?
  position Int     @default(0)

  options VariantOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@unique([productId, slug])
  @@index([productId])
  @@map("variant_group")
}

model VariantOption {
  id Int @id @default(autoincrement())

  groupId Int
  group   VariantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  value    String
  slug     String?
  metadata Json?
  position Int     @default(0)

  variants ProductVariantOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, value])
  @@unique([groupId, slug])
  @@index([groupId])
  @@map("variant_option")
}

model ProductVariant {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku       String  @unique
  size      String?
  color     String?
  colorCode String?
  barcode   String? @unique

  price             Decimal?
  importPrice       Decimal  @default(0)
  sellPrice         Decimal  @default(0)
  comparePrice      Decimal?
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int?
  isActive          Boolean  @default(true)
  weight            Decimal?
