DEV_DATABASE_URL="postgresql://dev-user:dev-password@dev-host:5432/dev-db?sslmode=require"

# Required for Vercel production runtime.
PRO_DATABASE_URL="postgresql://prod-user:prod-password@prod-host:5432/prod-db?sslmode=require"
# Optional direct/unpooled URL used only by `prisma migrate deploy`.
# For Neon, use the direct host here (without `-pooler`).
PRO_DIRECT_DATABASE_URL=""

# Optional local fallback only. Production intentionally does not use this.
DATABASE_URL=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="https://quynhnhistore.com"
NEXT_PUBLIC_NODE_ENV="local"

# Use exactly one of these deployment configurations.
# Development:
# NODE_ENV="development"
# APP_URL="https://dev.quynhnhistore.com"
# ENABLE_SWAGGER="true"
# Production:
# NODE_ENV="production"
# APP_URL="https://quynhnhistore.com"
# ENABLE_SWAGGER="true"

# Deployment examples:
# Development: NEXT_PUBLIC_SITE_URL="https://dev.quynhnhistore.com"
# Production: NEXT_PUBLIC_SITE_URL="https://quynhnhistore.com"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

AUTH_SECRET="change-me-to-a-long-random-secret"
AUTH_DEV_OTP_ENABLED="true"

GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
GMAIL_FROM_EMAIL=""
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT="465"

NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Browser key restricted by HTTP referrers and Maps JavaScript/Places APIs.
GEOAPIFY_API_KEY=""
SHOP_LATITUDE="11.275790867301161"
SHOP_LONGITUDE="106.5892647696457"
CRON_SECRET=""

# VNPAY payment gateway. Use sandbox values for testing, production values after approval.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL=""

# Optional server-side AI provider for the customer shopping assistant.
# Gemini AI Studio has a free tier with rate limits; the rule-based assistant
# remains the fallback when this key is missing or the provider is unavailable.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"

# Optional public Hugging Face Space used by the free virtual try-on MVP.
VTON_SPACE_ID="https://yisol-idm-vton.hf.space"
# Set true only when VTON_SPACE_ID points to a Space whose /tryon endpoint
# accepts category as a ninth argument: upper_body, lower_body, or dresses.
VTON_CATEGORY_MODE="false"

# Web Push VAPID keys. Keep the private key backend-only and stable per environment.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@quynhnhistore.com"
